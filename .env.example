# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tea_estate_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# pgAdmin 4 Configuration
PGADMIN_PORT=5050
PGADMIN_EMAIL=your_admin_email@domain.com
PGADMIN_PASSWORD=your_secure_pgadmin_password_here

# JWT Authentication (Backend Web API)
JWT_SECRET=your_32_character_minimum_random_secret_key_here!
JWT_ISSUER=TeaEstateApi
JWT_AUDIENCE=TeaEstateClient

# App Environment & Branding Placeholder
APP_NAME=Tea Estate 360
APP_ENV=development
